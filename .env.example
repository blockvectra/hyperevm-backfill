# BlockVectra API Key
# Obtain via Web Console: https://blockvectra.com/en/get-api-key/
# Programmatic Onboarding: https://docs.blockvectra.com/en/guides/programmatic-signup/
BLOCKVECTRA_API_KEY=rgw_your_api_key_here

# Target contract or address for backfill
TARGET_ADDRESS=0x1111111111111111111111111111111111111111

# Optional block range overrides
FROM_BLOCK=0
TO_BLOCK=2000

# Optional: set to true to query Data API address transfers instead of eth_getLogs
USE_DATA_API=false
